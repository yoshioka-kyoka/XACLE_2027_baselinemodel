{
    "encoder_type": "cached_embedding",
    "train_list": "./datasets/XACLE_Challenge_2027_development_dataset/meta_data/train_average.csv",
    "validation_list": "./datasets/XACLE_Challenge_2027_development_dataset/meta_data/validation_average.csv",
    "test_list": "./datasets/XACLE_Challenge_2027_development_dataset/meta_data/test_average.csv",
    "output_dir": "./chkpt",
    "batch_size": 12,
    "val_batch_size": 12,
    "lr": 0.00002,
    "num_workers": 2,
    "epochs": 20,
    "max_len": 10,
    "early_stop_patience": 10,
    "device": "cuda",
    "seed": 42,
    "loss": {
        "loss_weights": [1.0, 0.5],
        "clipped_mse": {
            "tau": 0.25,
            "mode": "utt",
            "beta": 0.99,
            "cbl": true
        },
        "contrastive": {
            "margin": 0.1,
            "beta": 0.99,
            "cbl": true
        }
    },
    "cached_embedding": {
        "embedding_dim": 2048,
        "normalize_embeddings": false,
        "train_embeddings": "./embeddings/qwen2.5-omni-3b/train.npz",
        "validation_embeddings": "./embeddings/qwen2.5-omni-3b/validation.npz",
        "test_embeddings": "./embeddings/qwen2.5-omni-3b/test.npz"
    },
    "model": {
        "projector": {
            "hidden_dim": 1024,
            "output_dim": 256,
            "activation": "ReLU",
            "dropout": 0.3
        },
        "score_predictor": {
            "range_clipping": false
        }
    }
}
